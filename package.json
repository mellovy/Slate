{
  "name": "slate",
  "productName": "Slate",
  "version": "1.0.0",
  "description": "Minimalist personal planner for courses, deadlines and time.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.personal.slate",
    "productName": "Slate",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "manvas.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "manvas.ico",
      "artifactName": "Slate-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
